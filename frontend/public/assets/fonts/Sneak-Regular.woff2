    <script>
  // If tracking consent is absent (never granted or revoked), remove any
  // identifiers a previous PostHog session left behind.
  window.addEventListener("CC_CONSENT_UPDATED", function (event) {
    var tracking = event.detail && event.detail.tracking;
    if (!tracking || tracking.consent) return;
    var isPosthogName = function (name) {
      return name.indexOf("ph_") === 0 && name.indexOf("_posthog") !== -1;
    };
    try {
      Object.keys(window.localStorage).forEach(function (name) {
        if (isPosthogName(name)) window.localStorage.removeItem(name);
      });
    } catch (error) {
      /* storage unavailable (private mode) — nothing to clean */
    }
    document.cookie.split(";").forEach(function (part) {
      var name = part.split("=")[0].trim();
      if (!isPosthogName(name)) return;
      var expire = "=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/";
      document.cookie = name + expire;
      document.cookie = name + expire + "; domain=." + location.hostname.replace(/^www\./, "");
    });
  });
</script>
